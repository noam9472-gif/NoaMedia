<Page x:Class="NoaMedia.Pages.AddUserAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add User - NoaMedia Dashboard">

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2C3E50" Padding="15">
            <Grid>
                <Button Content="Back" Click="Cancel_Click" HorizontalAlignment="Left" 
                        Padding="15,5" Background="#34495E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="Create New User Account" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30" MaxWidth="500">

                <Border Background="White" CornerRadius="8" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="User Credentials" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <TextBlock Text="Full Name" Foreground="#7F8C8D" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtName" Padding="10" BorderBrush="#DCDDE1"/>

                        <TextBlock Text="Username" Foreground="#7F8C8D" Margin="0,15,0,5"/>
                        <TextBox x:Name="txtUserName" Padding="10" BorderBrush="#DCDDE1"/>

                        <TextBlock Text="Email Address" Foreground="#7F8C8D" Margin="0,15,0,5"/>
                        <TextBox x:Name="txtEmail" Padding="10" BorderBrush="#DCDDE1"/>

                        <TextBlock Text="Password" Foreground="#7F8C8D" Margin="0,15,0,5"/>
                        <PasswordBox x:Name="txtPassword" Padding="10" BorderBrush="#DCDDE1"/>

                        <TextBlock Text="Date of Birth" Foreground="#7F8C8D" Margin="0,15,0,5"/>
                        <DatePicker x:Name="dpBirthDate" Padding="5"/>

                        <CheckBox x:Name="chkIsAdmin" Content="Grant Premium Privileges" Margin="0,20,0,0" VerticalContentAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Discard" Click="Cancel_Click" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" Margin="0,0,20,0" Cursor="Hand"/>
                    <Button Content="Create User" Click="SaveUser_Click" Width="150" Height="45" 
                            Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>