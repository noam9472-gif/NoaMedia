<Page x:Class="NoaMedia.Pages.AddVideoAdmin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add Movie - NoaMedia Dashboard">

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2C3E50" Padding="15">
            <Grid>
                <Button Content="Back" Click="Cancel_Click" HorizontalAlignment="Left" 
                        Padding="15,5" Background="#34495E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="Add New Movie Content" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <Border Background="White" CornerRadius="8" Padding="25" MaxWidth="800">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="General Information" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                            <TextBlock Text="Movie Title" Foreground="#7F8C8D" Margin="0,10,0,5"/>
                            <TextBox x:Name="txtVideoName" Padding="10" BorderBrush="#DCDDE1" BorderThickness="1"/>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Genre" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cbGenre" DisplayMemberPath="GenreDescription" Padding="8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Age Rating" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cbAge" DisplayMemberPath="Description" Padding="8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Duration (Minutes)" Foreground="#7F8C8D" Margin="0,15,0,5"/>
                            <TextBox x:Name="txtLength" Padding="10" PreviewTextInput="NumberValidationTextBox" BorderBrush="#DCDDE1"/>

                            <TextBlock Text="Description" Foreground="#7F8C8D" Margin="0,15,0,5"/>
                            <TextBox x:Name="txtDescription" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" BorderBrush="#DCDDE1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Text="Media &amp; Visuals" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                            <Border BorderBrush="#DCDDE1" BorderThickness="1" CornerRadius="5" Height="250" Background="#F8F9FA">
                                <Grid>
                                    <Image x:Name="imgPreview" Stretch="UniformToFill"/>
                                    <TextBlock x:Name="txtPlaceholder" Text="No Image Selected" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BDC3C7"/>
                                </Grid>
                            </Border>

                            <Button Content="Upload Poster" Click="UploadImage_Click" Margin="0,15,0,0" 
                                    Background="#3498DB" Foreground="White" BorderThickness="0" Padding="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblFileName" Text="Max size: 2MB" FontSize="10" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" MaxWidth="800" Margin="0,20,0,0">
                    <Button Content="Discard Changes" Click="Cancel_Click" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" Margin="0,0,20,0" Cursor="Hand"/>
                    <Button Content="Publish Movie" Click="SaveVideo_Click" Width="150" Height="45" 
                            Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>