<Page x:Class="NoaMedia.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ניהול מערכת - NoaMedia">

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2C3E50" Padding="15">
            <Grid>
                <Button Content="Back to Menu" Click="BackToMenu_Click" HorizontalAlignment="Left" 
                        Padding="10,5" Background="#34495E" Foreground="White" BorderThickness="0"/>
                <TextBlock Text="Hello Admin!" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="15" Background="White">
            <TabItem Header="Users">
                <StackPanel>
                    <Button Content="Add New User" Click="AddUser_Click" Width="120" HorizontalAlignment="Left" Margin="10,10,0,0" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="5"/>
                    <DataGrid x:Name="dgAllUsers" 
                                AutoGenerateColumns="False" CanUserAddRows="False" Margin="10" MouseDoubleClick="dgAllUsers_MouseDoubleClick"  CellEditEnding="dgAllUsers_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="User's Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Date Of Birth" Binding="{Binding DateOfBirth, StringFormat=\{0:dd/MM/yyyy\}}" Width="80"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Mail}" Width="*"/>
                            <DataGridTextColumn Header="Password" Binding="{Binding Pass}" Width="*"/>
                            <DataGridTextColumn Header="UserName" Binding="{Binding UserName}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Premium" Binding="{Binding IsPremium}" Width="80"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Click="DeleteUser_Click" Background="#E74C3C" Foreground="White" Padding="5,2" Cursor="Hand" FontWeight="Bold" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Users Premium">
                <DataGrid x:Name="dgPremiumUsers" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="User's Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Date Of Birth"  Binding="{Binding DateOfBirth, StringFormat=\{0:dd/MM/yyyy\}}"   Width="80"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Mail}" Width="*"/>
                        <DataGridTextColumn Header="Password" Binding="{Binding Pass}" Width="*"/>
                        <DataGridTextColumn Header="UserName" Binding="{Binding UserName}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Genres">
                <StackPanel>
                    <WrapPanel Margin="10,10,0,0">
                        <Button Content="Add New Genre" Click="AddGenre_Click" Width="130" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,10,0"/>

                        <Button Content="Move Movies Between Genres" Click="MoveMovies_Click" Width="200" Background="#F39C12" Foreground="White" BorderThickness="0" Padding="5"/>
                    </WrapPanel>
                    <DataGrid x:Name="dgGenres" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Genre Name" Binding="{Binding GenreDescription}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Click="DeleteGenre_Click" Background="#E74C3C" Foreground="White" Padding="5,2" Cursor="Hand" FontWeight="Bold" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Videos Management">
                <StackPanel>
                    <Button Content="Add New Movie" Click="AddMovie_Click" Width="120" HorizontalAlignment="Left" Margin="10,10,0,0" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="5"/>
                    <DataGrid x:Name="dgMovies" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10" MouseDoubleClick="dgMovies_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="25"/>
                            <DataGridTextColumn Header="Movie's Name" Binding="{Binding VideoName}" Width="*"/>
                            <DataGridTextColumn Header="Genre" Binding="{Binding Genre.GenreDescription}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Change Genre" Click="ChangeMovieGenre_Click" Background="#3498DB" Foreground="White" Padding="5,2" Margin="0,0,5,0" Cursor="Hand" FontWeight="Bold" BorderThickness="0"/>

                                            <Button Content="Delete" Click="DeleteMovie_Click" Background="#E74C3C" Foreground="White" Padding="5,2" Cursor="Hand" FontWeight="Bold" BorderThickness="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Video Reviews">
                <DataGrid x:Name="dgComments" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User" Binding="{Binding WhoUpdatedTheReview.UserName}" Width="*"/>
                        <DataGridTextColumn Header="Movie" Binding="{Binding WhichVideoDidTheUserReview.VideoName}" Width="*"/>
                        <DataGridTextColumn Header="Comment" Binding="{Binding ReviewDescription}" Width="2*"/>
                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Click="DeleteReview_Click" Background="#E74C3C" Foreground="White" Padding="5,2" Cursor="Hand" FontWeight="Bold" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>