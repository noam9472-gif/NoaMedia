<Page x:Class="NoaMedia.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:NoaMedia" 
      Title="Home" Background="#141414">

    <Page.Resources>
        <DataTemplate x:Key="MovieTemplate">
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Hi " Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock x:Name="UserNameText" Text="User" Foreground="#E50914" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="!" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!--<Button x:Name="AdminMenuButton" 
            Content="⚙ Menu" 
            Click="AdminMenu_Click" 
            Width="90" Height="35" 
            Background="#444" Foreground="White" 
            BorderThickness="0" Margin="0,0,15,0" 
            Cursor="Hand"/>-->
                
                
                <Button x:Name="UpgradeButton" 
                Content="Get Premium 👑" 
                Click="UpgradeButton_Click" 
                Width="120" Height="35" 
                Background="#FFD700" Foreground="Black" 
                FontWeight="Bold" BorderThickness="0" 
                Margin="0,0,15,0" Cursor="Hand"
                Visibility="Collapsed"/>

                <Button x:Name="AddMovieButton" 
                Content="+ Add Movie" 
                Click="AddMovie_Click" 
                Width="110" Height="35" 
                Background="#333" Foreground="White" 
                BorderThickness="0" Margin="0,0,15,0" 
                Cursor="Hand"
                Visibility="Collapsed"/>

                <Button x:Name="ProfileButton"
                Click="Profile_Click" 
                Background="Transparent" 
                BorderThickness="0" 
                Cursor="Hand">
                    <Border Width="40" Height="40" Background="#E50914" CornerRadius="5">
                        <TextBlock Text="U" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainGenresContainer" Margin="30,0,30,20" Orientation="Vertical">
            </StackPanel>
        </ScrollViewer>
        
        
    </Grid>
</Page>