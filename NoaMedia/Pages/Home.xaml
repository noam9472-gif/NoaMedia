<Page x:Class="NoaMedia.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:NoaMedia" 
      Title="Home" Background="#141414">

    <Page.Resources>
        <DataTemplate x:Key="MovieTemplate">
            <Button Click="WatchMovie_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0">
                <StackPanel Width="180">
                    <Border CornerRadius="8" ClipToBounds="True" Background="#222" Height="270">
                        <Image Source="{Binding MoviePoster}" Stretch="UniformToFill" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="{Binding MovieName}" Foreground="White" FontSize="14" 
                           FontWeight="SemiBold" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ReleaseYear}" Foreground="#888" FontSize="12" Margin="2,2,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Hi " Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock x:Name="UserNameText" Text="User" Foreground="#E50914" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="!" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <Button x:Name="BackToMenuButton" 
                   Content="Back To The Menu" 
                   Click="BackToMenu_Click" 
                   Width="130" Height="35" 
                   Background="#E50914" Foreground="White" 
                   FontWeight="Bold" BorderThickness="0" 
                   Margin="0,0,15,0" Cursor="Hand"
                   Visibility="Collapsed"/>

                
                

                <Button x:Name="UpgradeButton" 
                Content="Get Premium 👑" 
                Click="UpgradeButton_Click" 
                Width="120" Height="35" 
                Background="#FFD700" Foreground="Black" 
                FontWeight="Bold" BorderThickness="0" 
                Margin="0,0,15,0" Cursor="Hand"
                Visibility="Collapsed"/>

                <Button x:Name="AddMovieButton" 
                Content="+ Add Movie" 
                Click="AddMovie_Click" 
                Width="110" Height="35" 
               Background="#E50914" Foreground="White"  
                BorderThickness="0" Margin="0,0,15,0" 
                Cursor="Hand"
                Visibility="Collapsed"/>

                <Button x:Name="ProfileButton"
                Click="Profile_Click" 
                Background="Transparent" 
                BorderThickness="0" 
                Cursor="Hand">
                    <Border Width="40" Height="40" Background="#E50914" CornerRadius="5">
                        <TextBlock Text="U" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18"/>
                    </Border>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainGenresContainer" Margin="30,0,30,20" Orientation="Vertical">
            </StackPanel>
        </ScrollViewer>
        
        
    </Grid>
</Page>