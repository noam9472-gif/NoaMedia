<Page x:Class="NoaMedia.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Movie Details" Background="#0A0A0A"
      SnapsToDevicePixels="True">

    <Grid>
        <Grid VerticalAlignment="Top" Height="700">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.3"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#0A0A0A" Offset="0.9"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Button Click="Back_Click" VerticalAlignment="Top" HorizontalAlignment="Left" 
                Margin="30" Background="#44000000" Foreground="White" BorderBrush="White"
                Padding="15,8" Cursor="Hand" Panel.ZIndex="10">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"/>
                </Style>
            </Button.Resources>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="BACK" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <Grid x:Name="HeroSection" Height="700" Margin="60,100,60,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="300" Height="450" CornerRadius="15" 
                            ClipToBounds="True" VerticalAlignment="Top">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Opacity="0.6" ShadowDepth="0"/>
                        </Border.Effect>
                        <Image x:Name="MainPosterImage" Stretch="UniformToFill" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="50,0,0,0">
                        <TextBlock x:Name="MovieTitle" Foreground="White" FontSize="64" FontWeight="ExtraBold" 
                                   TextWrapping="Wrap" Text="MOVIE TITLE"/>

                        <StackPanel Orientation="Horizontal" Margin="0,15">
                            <Border Background="#E50914" CornerRadius="4" Padding="12,5">
                                <TextBlock x:Name="MovieGenre" Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="MovieDuration" Foreground="#CCC" FontSize="18" Margin="25,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ReleaseYear" Foreground="#888" FontSize="18" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="MovieDesc" Foreground="#DDD" FontSize="18" LineHeight="28"
                                   MaxWidth="700" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,10,0,40"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayButton" Click="PlayButton_Click" Width="200" Height="60" 
                                    Background="White" Foreground="Black" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" Margin="0,0,12,0" FontSize="20"/>
                                    <TextBlock Text="PLAY NOW" FontWeight="Bold" FontSize="18"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="LikeButton" Click="LikeButton_Click" Width="60" Height="60" 
                                    Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" Margin="20,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="30"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock x:Name="LikeIcon" Text="❤" Foreground="White" FontSize="24"/>
                            </Button>

                            <Button x:Name="MyListButton" Click="MyListButton_Click" Width="60" Height="60" 
                                    Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" Margin="0,0,20,0"
                                    Visibility="Collapsed">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="30"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock x:Name="MyListIcon" Text="+" Foreground="White" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.ColumnSpan="2" Margin="0,0,0,30"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MoreInfoButton_Click">
                        <StackPanel>
                            <TextBlock Text="Storyline &amp; Reviews" Foreground="White" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Margin="60,40,60,60">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Synopsis" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                            <TextBlock x:Name="FullDescriptionText" Foreground="#BBB" FontSize="17" TextWrapping="Wrap" LineHeight="28"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="60,0,0,0">
                            <TextBlock Text="Credits" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                            <TextBlock Text="CURATED BY" Foreground="#E50914" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="WhoUploadedName" Foreground="White" FontSize="18" Margin="0,5,0,25"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#222" Margin="0,60"/>

                    <StackPanel>
                        <TextBlock Text="Member Reviews" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,0,0,30"/>

                        <Border Background="#1A1A1A" CornerRadius="12" Padding="20" Margin="0,0,0,30" BorderBrush="#333" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtNewReview" Background="Transparent" Foreground="White" 
                                         BorderThickness="0" FontSize="16" TextWrapping="Wrap" 
                                         AcceptsReturn="True" MaxLength="500" MinHeight="40"
                                         VerticalContentAlignment="Center" Margin="0,0,15,0"
                                         Tag="Write a review..."/>

                                <Button Grid.Column="1" x:Name="AddReviewBtn" Click="AddReviewButton_Click" 
                                        Content="POST" Background="#E50914" Foreground="White" 
                                        FontWeight="Bold" Padding="25,10" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <ListBox x:Name="lstMovieReviews" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121212" Margin="0,0,0,15" Padding="20" CornerRadius="10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding WhoUpdatedTheReview.Name}" 
                               Foreground="#E50914" FontWeight="Bold" FontSize="16"/>

                                                <TextBlock Grid.Column="1" 
                               Text="{Binding ReviewDate, StringFormat='{}{0:dd/MM/yyyy }'}" 
                               Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>

                                                <Button Grid.Column="2" x:Name="DeleteReviewBtn" Click="DeleteReviewBtn_Click"
                            Content="" FontFamily="Segoe MDL2 Assets" Foreground="#666"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            VerticalAlignment="Center" ToolTip="Delete Review"/>
                                            </Grid>

                                            <TextBlock Text="{Binding ReviewDescription}" 
                           Foreground="#AAA" FontSize="15" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="VideoLayer" Visibility="Collapsed" Background="Black" Panel.ZIndex="100">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <MediaElement x:Name="InlinePlayer" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" ScrubbingEnabled="True" MediaOpened="InlinePlayer_MediaOpened" BufferingStarted="InlinePlayer_BufferingStarted" BufferingEnded="InlinePlayer_BufferingEnded"/>

            <StackPanel x:Name="LoadingStatus" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Foreground="#E50914" Background="#333"/>
                <TextBlock Text="Loading Movie..." Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="18"/>
            </StackPanel>

            <Button Content="✕ Close" Click="CloseVideo_Click" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20" Padding="15,5" Background="#CC000000" Foreground="White" BorderThickness="1" BorderBrush="White" Cursor="Hand" Panel.ZIndex="101"/>

            <Border Grid.Row="1" Background="#AA000000" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeStatus" Grid.Column="0" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="-10s" Click="Rewind_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Slider x:Name="TimelineSlider" Grid.Column="2" Minimum="0" Maximum="100" VerticalAlignment="Center" PreviewMouseLeftButtonUp="TimelineSlider_MouseUp" Cursor="Hand"/>
                    <Button Grid.Column="3" Content="+10s" Click="Forward_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,10,0"/>
                    <TextBlock x:Name="TotalTime" Grid.Column="4" Text="00:00" Foreground="White" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>