<Page x:Class="NoaMedia.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Movie Details" Background="#141414"
      SnapsToDevicePixels="True">

    <Grid>
        <Button Content="← Back" Click="Back_Click" 
                VerticalAlignment="Top" HorizontalAlignment="Left" 
                Margin="20" Padding="12,6" 
                Background="#333" Foreground="White" 
                FontSize="14" BorderThickness="0" Cursor="Hand" Panel.ZIndex="10">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
        </Button>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,80,40,40">
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="MovieTitle" Foreground="White" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                            <Border Background="#E50914" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock x:Name="MovieGenre" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="MovieDuration" Foreground="#AAA" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="MovieDesc" Foreground="#DDD" FontSize="16" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="600" Margin="0,10,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="LikeButton" Click="LikeButton_Click" Width="45" Height="40" Background="#22FFFFFF" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                                <TextBlock x:Name="LikeIcon" Text="❤" Foreground="White" FontSize="18"/>
                            </Button>
                            <Button x:Name="PlayButton" Content="▶ Play" Click="PlayButton_Click" Width="120" Height="40" Background="#E50914" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="220" Height="125" CornerRadius="8" ClipToBounds="True" BorderBrush="#333" BorderThickness="1" VerticalAlignment="Top">
                        <Image x:Name="BackgroundImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>

                <Separator Background="#333" Margin="0,20"/>

                <Grid x:Name="DetailedInfoPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="Synopsis" Foreground="#E50914" FontSize="20" FontWeight="Bold" TextAlignment="Right" Margin="0,0,0,10"/>
                        <TextBlock x:Name="FullDescriptionText" Foreground="White" FontSize="16" TextAlignment="Right" TextWrapping="Wrap" LineHeight="24"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Info" Foreground="#E50914" FontSize="20" FontWeight="Bold" TextAlignment="Right" Margin="0,0,0,10"/>
                        <TextBlock Text="Uploaded By" Foreground="Gray" FontSize="14" TextAlignment="Right"/>
                        <TextBlock x:Name="WhoUploadedName" Foreground="White" FontSize="16" TextAlignment="Right" Margin="0,0,0,15"/>
                        <TextBlock Text="Release Date" Foreground="Gray" FontSize="14" TextAlignment="Right"/>
                        <TextBlock x:Name="ReleaseYear" Foreground="White" FontSize="16" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Separator Background="#333" Margin="0,40"/>

                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Button x:Name="AddReviewButton" Content="+ Write a Review" Click="AddReviewButton_Click" 
                                HorizontalAlignment="Left" Background="Transparent" Foreground="#E50914" 
                                BorderThickness="0" Cursor="Hand" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Recent Reviews" Foreground="White" FontSize="24" FontWeight="Bold" TextAlignment="Right"/>
                    </Grid>

                    <ListBox x:Name="lstMovieReviews" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A1D" Margin="0,0,0,12" Padding="20" CornerRadius="10" BorderBrush="#333" BorderThickness="1">
                                    <StackPanel>
                                        <Button Content="{Binding WhoUpdatedTheReview.UserName}" 
                                                Click="ReviewUser_Click" 
                                                Foreground="#E50914" FontWeight="Bold" Background="Transparent" 
                                                BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding ReviewDescription}" Foreground="White" FontSize="15" 
                                                   TextWrapping="Wrap" TextAlignment="Right" Opacity="0.9"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="VideoLayer" Visibility="Collapsed" Background="Black" Panel.ZIndex="100">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <MediaElement x:Name="InlinePlayer" 
                          Grid.Row="0"
                          LoadedBehavior="Manual" 
                          UnloadedBehavior="Stop" 
                          Stretch="Uniform"
                          ScrubbingEnabled="True"
                          MediaOpened="InlinePlayer_MediaOpened"
                          BufferingStarted="InlinePlayer_BufferingStarted"
                          BufferingEnded="InlinePlayer_BufferingEnded"/>

            <StackPanel x:Name="LoadingStatus" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Foreground="#E50914" Background="#333"/>
                <TextBlock Text="Loading Movie..." Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="18"/>
            </StackPanel>

            <Button Content="✕ Close" Click="CloseVideo_Click" 
                    VerticalAlignment="Top" HorizontalAlignment="Left" 
                    Margin="20" Padding="15,5" 
                    Background="#CC000000" Foreground="White" 
                    BorderThickness="1" BorderBrush="White" Cursor="Hand" Panel.ZIndex="101"/>

            <Border Grid.Row="1" Background="#AA000000" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TimeStatus" Grid.Column="0" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button Grid.Column="1" Content="-10s" Click="Rewind_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                    <Slider x:Name="TimelineSlider" Grid.Column="2" 
                            Minimum="0" Maximum="100" 
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonUp="TimelineSlider_MouseUp"
                            Cursor="Hand"/>

                    <Button Grid.Column="3" Content="+10s" Click="Forward_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="10,0,10,0"/>

                    <TextBlock x:Name="TotalTime" Grid.Column="4" Text="00:00" Foreground="White" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>