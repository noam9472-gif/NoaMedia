<Page x:Class="NoaMedia.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="My Profile" Background="#141414" Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#000" BorderBrush="#222" BorderThickness="0,0,1,0">
            <Grid Margin="20,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,40">
                    <Border Width="80" Height="80" Background="#E50914" CornerRadius="40" HorizontalAlignment="Left">
                        <TextBlock x:Name="ProfileInitialText" Text="U" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="UserNameHeading" Text="User Name" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,15,0,5"/>
                    <Border x:Name="PremiumBadge" Background="#FFD700" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock Text="PREMIUM MEMBER" Foreground="Black" FontSize="10" FontWeight="ExtraBold"/>
                    </Border>
                </StackPanel>

                <ListBox x:Name="MenuListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                         SelectionChanged="MenuListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="MenuBorder" Padding="15,12" Background="{TemplateBinding Background}" CornerRadius="8" Margin="0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="MenuBorder" Property="Background" Value="#E50914"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MenuBorder" Property="Background" Value="#333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <TextBlock Text="MY VIDEOS" Foreground="White" FontWeight="SemiBold" Tag="MyVideos"/>
                    <TextBlock Text="LIKED VIDEOS" Foreground="White" FontWeight="SemiBold" Tag="Liked"/>
                    <TextBlock Text="WATCHED HISTORY" Foreground="White" FontWeight="SemiBold" Tag="Watched"/>
                    <TextBlock Text="MY LIST (PREMIUM)" Foreground="#FFD700" FontWeight="SemiBold" Tag="MyList"/>
                    <TextBlock Text="MY COMMENTS" Foreground="White" FontWeight="SemiBold" Tag="Comments"/>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Button Content="Logout" Click="Logout_Click" Background="Transparent" Foreground="#888" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,10"/>
                    <Button Content="← Back to Home" Click="Back_Click" Background="#333" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="40">
            <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" Text="My Videos" Foreground="White" FontSize="32" FontWeight="Bold" Margin="0,0,0,30"/>

                    <WrapPanel x:Name="MainDisplayPanel" />

                    <Button x:Name="ShowAllHistoryButton" 
                            Content="לצפייה בשאר הסרטים" 
                            Visibility="Collapsed" 
                            Click="ShowAllHistory_Click"
                            Background="#E50914" Foreground="White" 
                            Padding="20,10" Margin="10,20,0,0" 
                            BorderThickness="0" Cursor="Hand" 
                            HorizontalAlignment="Left" FontWeight="Bold"/>

                    <StackPanel x:Name="CommentsDisplayPanel" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="PremiumLockPanel" Visibility="Collapsed" Background="#1A1A1A" CornerRadius="15" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Premium Feature" Foreground="#FFD700" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="To use 'My List', you need to upgrade your account to Premium. Enjoy ad-free watching, exclusive content, and more!" 
                               Foreground="#AAA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,15" LineHeight="22"/>
                    <Button Content="UPGRADE NOW" Click="Upgrade_Click" Background="#E50914" Foreground="White" FontWeight="Bold" Padding="30,12" BorderThickness="0" Cursor="Hand" Margin="0,10"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>