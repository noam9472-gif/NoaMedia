<Page x:Class="NoaMedia.Pages.SignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoaMedia.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1000"
      Title="SignUp">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/MainPicture.jpeg" Stretch="UniformToFill" Opacity="0.4"/>
        </Grid.Background>

        <Rectangle Fill="Black" Opacity="0.7"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">

                <Border Background="Black" Opacity="0.9" CornerRadius="8" Padding="40,30" Width="450">
                    <StackPanel>
                        <TextBlock Text="Welcome To NoaMedia!" 
                                   Foreground="#E50914" 
                                   FontSize="30" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,25" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="User Name" Foreground="#8c8c8c" Margin="0,0,0,5" FontSize="13"/>
                        <Border Background="#333333" CornerRadius="4" Margin="0,0,0,15">
                            <TextBox x:Name="NewUserTextBox" Padding="10" BorderThickness="0" FontSize="16" 
                                     Background="Transparent" Foreground="White" CaretBrush="White"/>
                        </Border>

                        <TextBlock Text="Full Name" Foreground="#8c8c8c" Margin="0,0,0,5" FontSize="13"/>
                        <Border Background="#333333" CornerRadius="4" Margin="0,0,0,15">
                            <TextBox x:Name="FullNameTextBox" Padding="10" BorderThickness="0" FontSize="16" 
                                     Background="Transparent" Foreground="White" CaretBrush="White"/>
                        </Border>

                        <TextBlock Text="Email" Foreground="#8c8c8c" Margin="0,0,0,5" FontSize="13"/>
                        <Border Background="#333333" CornerRadius="4" Margin="0,0,0,15">
                            <TextBox x:Name="EmailTextBox" Padding="10" BorderThickness="0" FontSize="16" 
                                     Background="Transparent" Foreground="White" CaretBrush="White"/>
                        </Border>

                        <TextBlock Text="Birth Date" Foreground="#8c8c8c" Margin="0,0,0,5" FontSize="13"/>
                        <DatePicker x:Name="BirthDatePicker" Width="370" Margin="0,0,0,15" Padding="5" 
                                    Background="#333333" BorderThickness="0" VerticalAlignment="Center"/>

                        <TextBlock Text="Password" Foreground="#8c8c8c" Margin="0,0,0,5" FontSize="13"/>
                        <Border Background="#333333" CornerRadius="4" Margin="0,0,0,25">
                            <PasswordBox x:Name="NewPasswordBox" Padding="10" BorderThickness="0" FontSize="16" 
                                         Background="Transparent" Foreground="White" CaretBrush="White"/>
                        </Border>

                        <Button Content="Sign Up" Click="RegisterBtn_Click" Height="45" Cursor="Hand"
                                Foreground="White" FontWeight="Bold" FontSize="16">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#E50914"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F40612"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Already have an account? Sign in" Background="Transparent" 
                                Foreground="#b3b3b3" BorderThickness="0" Margin="0,20,0,0" 
                                Click="BackToLogin_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>