<Page x:Class="NoaMedia.Pages.TransitionOptionForManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NoaMedia.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="אפשרויות ניהול - NoaMedia">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF2C3E50" Offset="0"/>
                <GradientStop Color="#FF000000" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Hello manager, where should we go next?" 
                       Foreground="White" FontSize="36" FontWeight="Bold" 
                       Margin="0,0,0,50" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Orientation="Horizontal">

                <Button x:Name="BtnUserMode" Click="BtnUserMode_Click"
                        Width="280" Height="180" Margin="20" 
                        Background="#3498DB" Foreground="White" 
                        Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel>
                        <TextBlock Text="🎬" FontSize="50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Viewing screen (user)" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnAdminMode" Click="BtnAdminMode_Click"
                        Width="280" Height="180" Margin="20" 
                        Background="#E74C3C" Foreground="White" 
                        Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel>
                        <TextBlock Text="🛠️" FontSize="50" HorizontalAlignment="Center"/>
                        <TextBlock Text="Management screen (admin)" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <Button Content="Log out" Click="Logout_Click" 
                    Background="Transparent" Foreground="#AAA" 
                    BorderThickness="0" Margin="0,40,0,0" Cursor="Hand" FontSize="16"/>
        </StackPanel>
    </Grid>
</Page>