<Page x:Class="NoaMedia.Pages.VideoDetailsPage"       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"       Title="VideoDetailsPage">
    <Grid Background="#1A1A1D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2C2C2E" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Back" Click="Back_Click" Background="#444" Foreground="White"                          Padding="15,5" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="NoaMedia Manager" VerticalAlignment="Center" Margin="20,0,0,0"                             Foreground="#E50914" FontWeight="Bold" FontSize="18"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                    <Image x:Name="imgPoster" Stretch="UniformToFill" Height="225">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="15" RadiusY="15" Rect="0,0,300,450"/>
                        </Image.Clip>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" Margin="40,0,0,0">
                    <TextBlock x:Name="txtTitle" Foreground="White" FontSize="42" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock x:Name="txtGenre" Foreground="#E50914" FontSize="18" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtYear" Foreground="#888" FontSize="18" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtDuration" Foreground="#888" FontSize="18"/>
                    </StackPanel>
                    <Separator Background="#333" Margin="0,0,0,25"/>
                    <TextBlock Text="Description" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtDescription" Foreground="#BBB" FontSize="17" TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,30"/>
                    <Border Background="#252525" Padding="15" CornerRadius="10" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Uploaded by: " Foreground="#888" VerticalAlignment="Center"/>
                            <Button x:Name="btnUploader" Click="btnUploader_Click" Background="Transparent"                                      BorderThickness="0" Foreground="#E50914" FontWeight="Bold"                                      Cursor="Hand" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Recent Reviews" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,40,0,15"/>
                    <ListBox x:Name="lstMovieReviews" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252525" Margin="0,0,0,12" Padding="20" CornerRadius="10">
                                    <StackPanel>
                                        <Button Content="{Binding User.UserName}" Click="ReviewUser_Click"                                                  Foreground="#E50914" FontWeight="Bold" Background="Transparent"                                                  BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding ReviewText}" Foreground="White" FontSize="15" TextWrapping="Wrap" Opacity="0.9"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>